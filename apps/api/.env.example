# Database (must match docker-compose: exposed on host port 5433, POSTGRES_PASSWORD)
POSTGRES_PASSWORD=nau_dev_password
DATABASE_URL=postgresql://nau:nau_dev_password@localhost:5433/nau_advisor
JWT_SECRET=your-rs256-private-key-here
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_DAYS=7
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-sonnet-4-6
# Optional: only used for one-time knowledge-base seeding with OpenAI embeddings.
# Runtime RAG uses the local embedding server, not this key.
OPENAI_API_KEY=sk-xxx
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@na.edu
ENCRYPTION_KEY=your-32-byte-hex-key
REDIS_URL=redis://localhost:6379
PORT=3001
NODE_ENV=development
ALLOWED_EMAIL_DOMAINS=nau.edu,student.na.edu,na.edu
# Comma-separated extra emails allowed beyond ALLOWED_EMAIL_DOMAINS (optional)
WHITELIST_EMAILS=
OCR_PROVIDER=tesseract
# Path to the Claude CLI binary (defaults to `claude` on PATH)
CLAUDE_BIN=claude
# Working directory for the advisor agent (defaults to ./advisor-agent)
AGENT_CWD=./advisor-agent
# Path to the institutional knowledge-base markdown used for seeding
NAU_KB_PATH=./knowledge-base/NAU_KNOWLEDGE_BASE.md
